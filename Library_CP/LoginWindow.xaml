<Window x:Class="Library_CP.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="450" Width="350"
        WindowsStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#97b1ce">
    
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="30">
            <TextBlock Text="Вход в библиотеку" FontSize="24" FontWeight="Bold"
             Foreground="#a7c5e7" HorizontalAlignment="Center" Margin="0,0,0,30"/>


        <TextBlock Text="Логин" Foreground="#576370" Margin="0,0,0,5"/>
        <TextBlock x:Name="TxtLogin" Padding="10" FontSize="14" BorderBrush="#BDC3C7"/>

        <TextBlock Text="Пароль" Foreground="#576370" Margin="0,15,0,5"/>
        <TextBlock x:Name="TxtLogin" Padding="10" FontSize="14" BorderBrush="#BDC3C7"/>

        <Button Content="Войти" Click="BtnLogin_Click" Margin="0,30,0,0"
         Padding="10" Background="#3498DB" Foreground="White"
         FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

        <TextBlock x:Name="TxtError" Foreground="#a7c5e7" 
         HorizontalAligment="Center" Margin=" 0,15,0,0"/>
            
         </StackPanel>
    </Grid>
</Window>
