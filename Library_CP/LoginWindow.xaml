<Window x:Class="Library_CP.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="30">
            <TextBlock Text="Вход в Библиотеку" FontSize="24" FontWeight="Bold" 
                       Foreground="#404a36" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Логин" Foreground="#7F8C8D" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Padding="10" FontSize="14" BorderBrush="#BDC3C7"/>

            <TextBlock Text="Пароль" Foreground="#7F8C8D" Margin="0,15,0,5"/>
            <PasswordBox x:Name="TxtPassword" Padding="10" FontSize="14" BorderBrush="#BDC3C7"/>

            <Button Content="Войти" Click="BtnLogin_Click" Margin="0,30,0,0"
                    IsDefault="True"
                    Padding="10" Background="#cee4b9" Foreground="#404a36"
                    FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="TxtError" Foreground="#9f5058" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>