<Window x:Class="Library_CP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека им. Горькова" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" Background="#364f6b">
            <StackPanel Margin="15,30,15,15">
                <TextBlock Text="ГОРЬКОВКА" Foreground="White" FontSize="24" 
                           FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                <Button Content="Книги" Click="BtnBooks_Click" 
                        Background="#34495E" Foreground="White" Padding="10" 
                        Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
