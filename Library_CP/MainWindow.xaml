<Window x:Class="Library_CP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#778773">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="15,30,15,15">
                    <TextBlock Text="Горьковка" Foreground="#dee9dd" FontSize="24" 
                               FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center"/>

                    <Button Content="Каталог книг" Click="BtnBooks_Click" 
                            Background="#c2ac94" Foreground="White" Padding="10" 
                            Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>

                    <Button Content="Мои книги" Click="BtnMyBooks_Click" 
                            Background="#c2ac94" Foreground="White" Padding="10" 
                            Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnAddBook" Content="Добавить книгу" Click="BtnAddBook_Click" 
                            Background="#27AE60" Foreground="White" Padding="10" 
                            Margin="0,0,0,10" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
                    <Button x:Name="BtnAllLoans" Content="Все выдачи" Click="BtnAllLoans_Click" 
                            Background="#8E44AD" Foreground="White" Padding="10" 
                            Margin="0,0,0,10" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,0,15,20">
                    <TextBlock x:Name="TxtUserName" Text="Пользователь" Foreground="#BDC3C7" 
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtUserRole" Text="Роль" Foreground="#7F8C8D" 
                               FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>