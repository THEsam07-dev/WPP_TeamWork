<Page x:Class="Library_CP.views.pages.ManageUsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление пользователями">

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление пользователями" FontSize="26" FontWeight="Bold" 
                   Margin="20" Foreground="#404a36" Grid.Row="0"/>

        <DataGrid ItemsSource="{Binding UsersList}" AutoGenerateColumns="False" 
                  Margin="20,0,20,20" Grid.Row="1" 
                  Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  CanUserAddRows="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Читательский билет" Binding="{Binding LibraryCardNumber}" Width="150"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Roles.RoleName}" Width="120"/>

                <DataGridTemplateColumn Header="Действия" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сменить роль" 
                                        Command="{Binding DataContext.ToggleRoleCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                        CommandParameter="{Binding}"
                                        Background="#778773" Foreground="White" 
                                        BorderThickness="0" Padding="5" Margin="0,0,5,0" Cursor="Hand"/>

                                <Button Content="Удалить" 
                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                        CommandParameter="{Binding}"
                                        Background="#e7b783" Foreground="White" 
                                        BorderThickness="0" Padding="5" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>