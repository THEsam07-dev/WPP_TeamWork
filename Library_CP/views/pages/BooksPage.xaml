<Page x:Class="Library_CP.views.pages.BooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:Library_CP.helpers"
      Title="Книги">

    <Page.Resources>
        <helpers:ByteArrayToImageConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Каталог книг" FontSize="26" FontWeight="Bold" Margin="20" Foreground="#2C3E50" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" Margin="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BooksList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="380" Margin="0,0,20,20" 
                                Background="White" CornerRadius="10" 
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="250"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#EAEAEA">
                                    <Image Source="{Binding CoverImage, Converter={StaticResource ImgConverter}}" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="15">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" 
                                               Foreground="#2C3E50" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Writers.WriterName}" Foreground="#7F8C8D" 
                                               FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding QuantityInStock, StringFormat='В наличии: {0} шт.'}" 
                                               Foreground="#3498DB" FontWeight="SemiBold" FontSize="13" Margin="0,15,0,0"/>
                                    <Button Content="Забронировать" Command="{Binding DataContext.BorrowBookCommand,RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" Background="#6a8aaf" Foreground="White" BorderThickness="0" Padding="5"
"                                           Cursor="Hand" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>