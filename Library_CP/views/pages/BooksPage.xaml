<Page x:Class="Library_CP.views.pages.BooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:Library_CP.helpers"
      Title="Книги">

    <Page.Resources>
        <helpers:ByteArrayToImageConverter x:Key="ImgConverter"/>
    </Page.Resources>

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Каталог книг" FontSize="26" FontWeight="Bold" Margin="20,20,20,10" Foreground="#404a36" Grid.Row="0"/>

        <Border Grid.Row="1" Margin="20,0,20,15" Background="White" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <TextBlock Text="🔍 Поиск по названию или автору..." Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Background="Transparent" BorderThickness="0" Padding="10" FontSize="14" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BooksList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="380" Margin="0,0,20,20" 
                            Background="White" CornerRadius="10" 
                            BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="250"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#EAEAEA">
                                    <Image Source="{Binding CoverImage, Converter={StaticResource ImgConverter}}" Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="15">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Writers.WriterName}" Foreground="#7F8C8D" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding QuantityInStock, StringFormat='В наличии: {0} шт.'}" Foreground="#3498DB" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,10"/>

                                    <Button Content="Забронировать"
                                            Command="{Binding DataContext.BorrowBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#c2ac94" Foreground="White"
                                            BorderThickness="0" Padding="8,5" Cursor="Hand" FontWeight="SemiBold"
                                            HorizontalAlignment="Left" Width="120" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>