<Page x:Class="Library_CP.views.pages.AllLoansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Все выдачи">

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Все выдачи книг" FontSize="26" FontWeight="Bold" 
                   Margin="20" Foreground="#404a36" Grid.Row="0"/>

        <DataGrid ItemsSource="{Binding LoansList}" AutoGenerateColumns="False" 
                  Margin="20,0,20,20" Grid.Row="1" 
                  Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  CanUserAddRows="False" IsReadOnly="True" BorderThickness="1" BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Заказа" Binding="{Binding OrderID}" Width="80"/>
                <DataGridTextColumn Header="Читатель" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Книга" Binding="{Binding BookTitle}" Width="2*"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>